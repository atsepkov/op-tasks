#!/usr/bin/env bash
set -euo pipefail

# leads — lightweight SQLite issue tracker
# Usage: leads <command> [args]

SCHEMA_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0")")/.." && pwd)"

# ── Helpers ──────────────────────────────────────────────────────────────────

die()  { printf 'error: %s\n' "$1" >&2; exit 1; }
info() { printf '%s\n' "$1"; }

find_git_root() {
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        [[ -d "$dir/.git" ]] && echo "$dir" && return
        dir="$(dirname "$dir")"
    done
    die "not inside a git repository"
}

db_path() {
    local root
    root="$(find_git_root)"
    echo "$root/.leads/issues.db"
}

ensure_db() {
    local db root
    root="$(find_git_root)"
    db="$root/.leads/issues.db"

    if [[ ! -f "$db" ]]; then
        mkdir -p "$root/.leads"
        sqlite3 "$db" < "$SCHEMA_DIR/schema.sql"

        # Append .leads/ to .gitignore if not already there
        local gi="$root/.gitignore"
        if [[ -f "$gi" ]]; then
            grep -qxF '.leads/' "$gi" 2>/dev/null || echo '.leads/' >> "$gi"
        else
            echo '.leads/' > "$gi"
        fi
    fi

    echo "$db"
}

sql() {
    local db="$1"; shift
    sqlite3 -batch "$db" "$@"
}

# Resolve an argument to an issue ID.
# If numeric, use directly. Otherwise, case-insensitive substring match on title.
resolve_id() {
    local db="$1" arg="$2" status_filter="${3:-}"

    if [[ "$arg" =~ ^[0-9]+$ ]]; then
        echo "$arg"
        return
    fi

    local where="title LIKE '%' || ? || '%' COLLATE NOCASE"
    [[ -n "$status_filter" ]] && where="$where AND status = '$status_filter'"

    local matches
    matches="$(sql "$db" "SELECT id, title FROM issues WHERE $where;" "$arg")"

    local count
    count="$(echo "$matches" | grep -c '|' || true)"

    if [[ "$count" -eq 0 ]]; then
        die "no issue matching '$arg'"
    elif [[ "$count" -eq 1 ]]; then
        echo "$matches" | cut -d'|' -f1
    else
        info "Multiple matches for '$arg':"
        echo "$matches" | while IFS='|' read -r mid mtitle; do
            printf '  #%-4s %s\n' "$mid" "$mtitle"
        done
        exit 1
    fi
}

# ── Commands ─────────────────────────────────────────────────────────────────

cmd_init() {
    local db
    db="$(ensure_db)"
    info "Initialized $(db_path)"
}

cmd_add() {
    local title="" label="bug"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -l|--label) label="$2"; shift 2 ;;
            -*) die "unknown flag: $1" ;;
            *)  title="$1"; shift ;;
        esac
    done
    [[ -z "$title" ]] && die "usage: leads add \"title\" [-l label]"

    local db
    db="$(ensure_db)"
    local id
    id="$(sql "$db" "INSERT INTO issues (title, label) VALUES (?, ?) RETURNING id;" "$title" "$label")"
    info "#$id $title [$label]"
}

cmd_list() {
    local label="" show_all=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --label|-l) label="$2"; shift 2 ;;
            --all|-a) show_all=1; shift ;;
            -*) die "unknown flag: $1" ;;
            *) die "unexpected argument: $1" ;;
        esac
    done

    local db
    db="$(ensure_db)"

    local where="1=1"
    [[ "$show_all" -eq 0 ]] && where="status = 'open'"
    [[ -n "$label" ]] && where="$where AND label = '$label'"

    sql "$db" -header -column "SELECT id, label, status, substr(title, 1, 60) AS title FROM issues WHERE $where ORDER BY id;"
}

cmd_show() {
    [[ $# -lt 1 ]] && die "usage: leads show <id-or-title>"
    local db
    db="$(ensure_db)"
    local id
    id="$(resolve_id "$db" "$1")"
    sql "$db" -header -column "SELECT * FROM issues WHERE id = $id;"
}

cmd_close() {
    [[ $# -lt 1 ]] && die "usage: leads close <id-or-title>"
    local db
    db="$(ensure_db)"
    local id
    id="$(resolve_id "$db" "$1" "open")"
    sql "$db" "UPDATE issues SET status = 'closed', closed = datetime('now') WHERE id = $id;"
    local title
    title="$(sql "$db" "SELECT title FROM issues WHERE id = $id;")"
    info "Closed #$id: $title"
}

cmd_reopen() {
    [[ $# -lt 1 ]] && die "usage: leads reopen <id-or-title>"
    local db
    db="$(ensure_db)"
    local id
    id="$(resolve_id "$db" "$1" "closed")"
    sql "$db" "UPDATE issues SET status = 'open', closed = NULL WHERE id = $id;"
    local title
    title="$(sql "$db" "SELECT title FROM issues WHERE id = $id;")"
    info "Reopened #$id: $title"
}

cmd_edit() {
    [[ $# -lt 1 ]] && die "usage: leads edit <id> [-t title] [-l label]"
    local id="$1"; shift
    local title="" label=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -t|--title) title="$2"; shift 2 ;;
            -l|--label) label="$2"; shift 2 ;;
            -*) die "unknown flag: $1" ;;
            *) die "unexpected argument: $1" ;;
        esac
    done

    local db
    db="$(ensure_db)"

    [[ -n "$title" ]] && sql "$db" "UPDATE issues SET title = ? WHERE id = $id;" "$title"
    [[ -n "$label" ]] && sql "$db" "UPDATE issues SET label = ? WHERE id = $id;" "$label"

    sql "$db" -header -column "SELECT id, label, title FROM issues WHERE id = $id;"
}

cmd_ready() {
    local db
    db="$(ensure_db)"
    local result
    result="$(sql "$db" -header -column "SELECT id, label, title FROM issues WHERE status = 'open' ORDER BY id LIMIT 1;")"
    if [[ -z "$result" ]]; then
        info "No open issues."
    else
        echo "$result"
    fi
}

cmd_migrate() {
    local root
    root="$(find_git_root)"
    local beads_db="$root/.beads/beads.db"
    [[ -f "$beads_db" ]] || die "no .beads/beads.db found at $root"

    local db
    db="$(ensure_db)"

    local count
    count="$(sql "$db" "SELECT COUNT(*) FROM issues;")"
    [[ "$count" -gt 0 ]] && die "leads DB already has $count issues — migrate only works on empty DB"

    # Import from beads, mapping labels
    sql "$db" "ATTACH '$beads_db' AS beads;"

    sql "$db" "
        INSERT INTO issues (title, label, status, created, beads_id)
        SELECT
            i.title,
            CASE l.label
                WHEN 'enhancement' THEN 'feature'
                WHEN 'security' THEN 'bug'
                ELSE COALESCE(l.label, 'bug')
            END,
            i.status,
            i.created_at,
            i.id
        FROM beads.issues i
        LEFT JOIN beads.labels l ON i.id = l.issue_id
        WHERE i.issue_type = 'task'
        ORDER BY i.created_at;
    "

    sql "$db" "DETACH beads;"

    local imported
    imported="$(sql "$db" "SELECT COUNT(*) FROM issues;")"
    info "Migrated $imported issues from beads."

    # Show summary by label
    sql "$db" -header -column "SELECT label, COUNT(*) AS count FROM issues GROUP BY label ORDER BY count DESC;"
}

cmd_help() {
    cat <<'EOF'
leads — lightweight SQLite issue tracker

Commands:
  add "title" [-l label]         Create issue (default label: bug)
  list [--label X] [--all]       List open issues (--all includes closed)
  show <id-or-title>             Show issue details
  close <id-or-title>            Close issue
  reopen <id-or-title>           Reopen closed issue
  edit <id> [-t "title"] [-l X]  Edit title or label
  ready                          Next open issue (lowest ID)
  migrate                        One-time import from .beads/beads.db
  init                           Explicitly init .leads/ (also auto-inits)

Labels: bug, feature, polish, techdebt
DB location: <git-root>/.leads/issues.db
EOF
}

# ── Dispatch ─────────────────────────────────────────────────────────────────

[[ $# -lt 1 ]] && { cmd_help; exit 0; }

case "$1" in
    add)     shift; cmd_add "$@" ;;
    list|ls) shift; cmd_list "$@" ;;
    show)    shift; cmd_show "$@" ;;
    close)   shift; cmd_close "$@" ;;
    reopen)  shift; cmd_reopen "$@" ;;
    edit)    shift; cmd_edit "$@" ;;
    ready)   shift; cmd_ready "$@" ;;
    migrate) shift; cmd_migrate "$@" ;;
    init)    shift; cmd_init "$@" ;;
    help|-h|--help) cmd_help ;;
    *) die "unknown command: $1 (try 'leads help')" ;;
esac
